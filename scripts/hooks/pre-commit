#!/bin/bash
# kobaamd pre-commit hook
# Swift ファイルが変更された場合にビルド＋テストコンパイルを確認する

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Swift ファイルが変更対象に含まれるか確認
SWIFT_CHANGED=$(git diff --cached --name-only | grep '\.swift$' || true)

if [ -z "$SWIFT_CHANGED" ]; then
    echo "Swift 変更なし → ビルド確認をスキップ"
else
    echo "🔨 Swift ファイルが変更されています。ビルドを確認します..."
    echo "$SWIFT_CHANGED" | sed 's/^/  /'

    ./scripts/apply-swiftterm-patches.sh

    # メインビルド確認
    if ! swift build 2>&1 | tail -3; then
        echo "❌ swift build 失敗。コミットを中止します。"
        exit 1
    fi

    # テストコンパイル確認（実行はXcode必須のためコンパイルのみ）
    echo "🧪 テストのコンパイルを確認します..."
    if ! swift build --target kobaamdTests 2>&1 | tail -3; then
        echo "❌ テストのコンパイル失敗。コミットを中止します。"
        exit 1
    fi
fi

# Shell スクリプトの claude -p variadic option 後置バグ検出
SH_CHANGED=$(git diff --cached --name-only | grep '\.sh$' || true)
if [ -n "$SH_CHANGED" ]; then
    echo "🐚 Shell スクリプトの CLI 引数 lint を確認します..."
    if ! scripts/lint/check-cli-args.sh --staged; then
        echo "❌ CLI 引数 lint 失敗。コミットを中止します。"
        exit 1
    fi
fi

ALLOWLIST_CHANGED=$(git diff --cached --name-only -- \
    .claude/agents/kobaamd_lint_section_context.md \
    docs/wiki/articles/practices/wiki-reference-policy.md \
    scripts/wiki/lib/section-context-check.sh \
    scripts/wiki/lib/verify_allowlist_drift.sh \
    Tests/wiki/section-context-allowlist.sh \
    Tests/wiki/verify-allowlist-drift.sh \
    .github/workflows/shell-tests.yml || true)
if [ -n "$ALLOWLIST_CHANGED" ]; then
    echo "🛡️ section-context allowlist drift を確認します..."
    if ! scripts/wiki/lib/verify_allowlist_drift.sh; then
        echo "❌ allowlist drift 検知に失敗。コミットを中止します。"
        exit 1
    fi
fi

# シークレット検出（全ステージングファイル対象、ただし以下は除外）
# - Sources/Resources/d2-browser.js: D2 描画用にバンドルされた WASM 入り JS。
#   ランダムなバイナリバイトが AKIA... / AIza... 等の正規表現に偽陽性ヒットするため除外。
# - *.wasm: 同様の理由でバイナリ全般を除外。
# 対象拡張時は SECRET_ALLOWLIST_PATHSPEC を明示的に増やすこと（恒久 bypass を作らない）。
echo "🔐 シークレット漏洩をチェックします..."
SECRET_PATTERNS='(sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{22,}|xoxb-[0-9]{10,}|xoxp-[0-9]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|sk-ant-[a-zA-Z0-9-]{20,})'
STAGED_DIFF=$(git diff --cached --diff-filter=ACMR -- \
    ':(exclude)Sources/Resources/d2-browser.js' \
    ':(exclude)*.wasm')
if echo "$STAGED_DIFF" | grep -qEi "$SECRET_PATTERNS"; then
    echo "❌ シークレットらしき文字列を検出しました。コミットを中止します。"
    echo "   検出箇所:"
    echo "$STAGED_DIFF" | grep -nEi "$SECRET_PATTERNS" | head -5 | sed 's/^/   /'
    echo ""
    echo "   誤検出の場合は scripts/hooks/pre-commit の SECRET_ALLOWLIST_PATHSPEC を見直してください（非推奨: --no-verify）"
    exit 1
fi

# 禁止ファイルパターンの検出
FORBIDDEN_FILES=$(git diff --cached --name-only | grep -Ei '\.(env|pem|key|p12|pfx|cer|keystore)$|credentials\.json|secrets\.json|auth\.json' || true)
if [ -n "$FORBIDDEN_FILES" ]; then
    echo "❌ シークレットファイルのコミットを検出しました:"
    echo "$FORBIDDEN_FILES" | sed 's/^/   /'
    echo ""
    echo "   .gitignore に追加するか、git commit --no-verify で回避できます（非推奨）"
    exit 1
fi

echo "✅ pre-commit 検査 OK"
exit 0
