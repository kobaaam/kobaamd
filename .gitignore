# Build artifacts
.build/
*.o
*.d

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode (if ever used)
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# Swift Package Manager
.swiftpm/

# Claude Code local settings (track project-level definitions, ignore caches/sessions)
# 自律パイプラインの subagent / slash command / skill 定義は git で管理する。
# `.claude/projects/`（セッション履歴）`.claude/cache/` 等はローカル限定。
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/commands/
!.claude/commands/**
!.claude/skills/
!.claude/skills/**

# Internal docs (not for public)
PRD.md
ARCHITECTURE.md
CLAUDE.md

# Test / scratch files
test-*.md
Untitled*.md

# E2E tests (xcodeproj is generated in VM, not committed)
E2ETests/kobaamdE2E.xcodeproj/

# Pipeline logs / state cache
.logs/

# Distribution artifacts
dist/

# Editor configs
.vscode/
*.swp
*~

# Sparkle EdDSA 秘密鍵 (Keychain 保管が原則だが、誤って書き出した場合の防御)
eddsa_priv*
*_priv_key*
*.pem
# テストリソースの .pem は追跡対象 (e.g. Tests/Resources/*.pem)
!Tests/Resources/*.pem

# Wiki lint キャッシュ（ローカル生成ファイル、コミット対象外）
.cache/
